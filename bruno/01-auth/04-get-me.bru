meta {
  name: Get Current User
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

tests {
  test("me returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("email matches admin", function() {
    const data = res.getBody();
    expect(data.user.email).to.equal("admin@acme.test");
  });
}
