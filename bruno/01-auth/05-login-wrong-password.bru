meta {
  name: Login Wrong Password (negative)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@acme.test",
    "password": "definitely-wrong"
  }
}

tests {
  test("rejected with 401/422", function() {
    const status = res.getStatus();
    expect(status === 401 || status === 422).to.equal(true);
  });
}
