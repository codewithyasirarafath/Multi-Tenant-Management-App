meta {
  name: List Alerts
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/organizations/{{orgId}}/notifications/alerts
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

tests {
  test("lists alerts", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data).to.be.an("array");
  });
}
