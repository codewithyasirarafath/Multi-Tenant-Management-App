meta {
  name: Update Status (pending -> in_transit)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/organizations/{{orgId}}/deliveries/{{deliveryId}}/status
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "status": "in_transit"
  }
}

tests {
  test("status updated", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.status).to.equal("in_transit");
  });
}
