meta {
  name: Track Delivery
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/organizations/{{orgId}}/deliveries/track/{{trackingNumber}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

tests {
  test("tracking lookup works", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.tracking_number).to.equal(bru.getEnvVar("trackingNumber"));
  });
}
