meta {
  name: List Deliveries (filter: pending)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/organizations/{{orgId}}/deliveries?status=pending&limit=10&offset=0
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

tests {
  test("lists deliveries", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data).to.be.an("array");
  });
  test("all rows are pending", function() {
    const data = res.getBody();
    data.forEach((d) => expect(d.status).to.equal("pending"));
  });
}
