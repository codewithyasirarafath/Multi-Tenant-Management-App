{
  "info": {
    "name": "Multi-Tenant Delivery Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "orgId",
      "value": "org-uuid-here"
    },
    {
      "key": "userId",
      "value": "user-uuid-here"
    },
    {
      "key": "webhookId",
      "value": "webhook-uuid-here"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@gmail.com\",\n  \"password\": \"Str0ngP@ss!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"mobile\": \"+1234567890\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@gmail.com\",\n  \"password\": \"Str0ngP@ss!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Auth - Get Current User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "Auth - Request Password Reset",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/password/reset-request",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "password", "reset-request"]
        }
      }
    },
    {
      "name": "Auth - Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"reset-token-here\",\n  \"newPassword\": \"NewStr0ngP@ss!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/password/reset",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "password", "reset"]
        }
      }
    },
    {
      "name": "Auth - Change Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"OldStr0ngP@ss!\",\n  \"newPassword\": \"NewStr0ngP@ss!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/password/change",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "password", "change"]
        }
      }
    },
    {
      "name": "Auth - Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"refresh-token-here\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/token/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "token", "refresh"]
        }
      }
    },
    {
      "name": "Auth - Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"refresh-token-here\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        }
      }
    },
    {
      "name": "Auth - Revoke All Sessions",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/sessions/revoke-all",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "sessions", "revoke-all"]
        }
      }
    },
    {
      "name": "Auth - Get Membership Codes by Email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/membership-codes",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "membership-codes"]
        }
      }
    },
    {
      "name": "Organizations - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations",
          "host": ["{{baseUrl}}"],
          "path": ["organizations"]
        }
      }
    },
    {
      "name": "Organizations - Get",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:id",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":id"],
          "variable": [{ "key": "id", "value": "org-uuid-here" }]
        }
      }
    },
    {
      "name": "Organizations - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Acme Corp\",\n  \"slug\": \"acme-corp\",\n  \"orgCode\": 123\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/organizations",
          "host": ["{{baseUrl}}"],
          "path": ["organizations"]
        }
      }
    },
    {
      "name": "Entities - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/entities",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "entities"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Entities - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Main Warehouse\",\n  \"code\": \"WH-001\",\n  \"entCode\": 789\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/entities",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "entities"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Users - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/users",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "users"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Users - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"mobile\": \"+1234567890\",\n  \"email\": \"john.doe@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/users",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "users"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Roles - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/roles",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "roles"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Roles - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"super_admin\",\n  \"description\": \"Super administrator with all permissions\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/roles",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "roles"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Memberships - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/users/:userId/memberships",
          "host": ["{{baseUrl}}"],
          "path": [
            "organizations",
            ":orgId",
            "users",
            ":userId",
            "memberships"
          ],
          "variable": [
            { "key": "orgId", "value": "{{orgId}}" },
            { "key": "userId", "value": "{{userId}}" }
          ]
        }
      }
    },
    {
      "name": "Memberships - Get Codes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/users/:userId/memberships/codes",
          "host": ["{{baseUrl}}"],
          "path": [
            "organizations",
            ":orgId",
            "users",
            ":userId",
            "memberships",
            "codes"
          ],
          "variable": [
            { "key": "orgId", "value": "{{orgId}}" },
            { "key": "userId", "value": "{{userId}}" }
          ]
        }
      }
    },
    {
      "name": "Memberships - Assign",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orgId\": \"org-uuid-here\",\n  \"entId\": \"ent-uuid-here\",\n  \"roleId\": \"role-uuid-here\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/users/:userId/memberships",
          "host": ["{{baseUrl}}"],
          "path": [
            "organizations",
            ":orgId",
            "users",
            ":userId",
            "memberships"
          ],
          "variable": [
            { "key": "orgId", "value": "{{orgId}}" },
            { "key": "userId", "value": "{{userId}}" }
          ]
        }
      }
    },
    {
      "name": "Deliveries - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/deliveries?limit=50&offset=0&status=pending",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "deliveries"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "offset", "value": "0" },
            { "key": "status", "value": "pending" }
          ]
        }
      }
    },
    {
      "name": "Deliveries - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"trackingNumber\": \"TRK-001\",\n  \"senderName\": \"John Doe\",\n  \"receiverName\": \"Jane Smith\",\n  \"destination\": \"New York\",\n  \"status\": \"pending\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/deliveries",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "deliveries"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Deliveries - Track",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/deliveries/track/:trackingNumber",
          "host": ["{{baseUrl}}"],
          "path": [
            "organizations",
            ":orgId",
            "deliveries",
            "track",
            ":trackingNumber"
          ],
          "variable": [
            { "key": "orgId", "value": "{{orgId}}" },
            { "key": "trackingNumber", "value": "TRK-001" }
          ]
        }
      }
    },
    {
      "name": "AI Chat - Ask",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"How many deliveries are pending?\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/ai-chat/ask",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "ai-chat", "ask"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Permissions - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/permissions",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "permissions"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Permissions - My Permissions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/users/:userId/my-permissions",
          "host": ["{{baseUrl}}"],
          "path": [
            "organizations",
            ":orgId",
            "users",
            ":userId",
            "my-permissions"
          ],
          "variable": [
            { "key": "orgId", "value": "{{orgId}}" },
            { "key": "userId", "value": "{{userId}}" }
          ]
        }
      }
    },
    {
      "name": "Webhooks - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/webhooks",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "webhooks"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Webhooks - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com/webhooks\",\n  \"events\": [\"delivery.created\", \"delivery.status_changed\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/webhooks",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "webhooks"],
          "variable": [{ "key": "orgId", "value": "{{orgId}}" }]
        }
      }
    },
    {
      "name": "Webhooks - Test",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/organizations/:orgId/webhooks/:webhookId/test",
          "host": ["{{baseUrl}}"],
          "path": ["organizations", ":orgId", "webhooks", ":webhookId", "test"],
          "variable": [
            { "key": "orgId", "value": "{{orgId}}" },
            { "key": "webhookId", "value": "{{webhookId}}" }
          ]
        }
      }
    }
  ]
