meta {
  name: Create Customer
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/organizations/{{orgId}}/customers
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

script:pre-request {
  const tag = bru.getEnvVar("runTag");
  req.setBody({
    entId: bru.getEnvVar("entId"),
    name: `Runner Customer ${tag}`,
    email: `customer.${tag}@example.test`,
    mobile: "+14155550777",
    address: "42 Runner Lane, Testville",
  });
}

script:post-response {
  const data = res.getBody();
  bru.setEnvVar("customerId", data.id);
}

tests {
  test("customer created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
