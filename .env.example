# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL (docker-compose.yml uses these too) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=delivery
DB_HOST=localhost
DB_PORT=5432
# Optional: overrides individual DB_* vars if set
DATABASE_URL=

# --- Connection pool tuning (optional, sensible defaults exist) ---
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=2000

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# --- Server ---
PORT=3000
CORS_ORIGIN=*
NODE_ENV=development

# --- AI chat (optional) ---
ANTHROPIC_API_KEY=
